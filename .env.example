# Where the app finds the backend. It is built into the app, so rebuild after changing it.
# Phone on the same Wi-Fi: your computer's LAN address, e.g. http://192.168.1.20:4000
# Emulator only: http://10.0.2.2:4000
# Production: https://your-backend.example.com
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
